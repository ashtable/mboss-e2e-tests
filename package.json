{
  "name": "@mboss/e2e-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "mBoss end-to-end suite — Playwright against the compose stack.",
  "license": "MIT",
  "engines": {
    "node": "24.18"
  },
  "scripts": {
    "lint": "tsc --noEmit && eslint . && prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:cloud": "playwright test --project=cloud",
    "e2e:mcp": "playwright test --project=mcp",
    "e2e:ext": "playwright test --project=extension",
    "stack:up": "docker compose -f docker-compose.e2e.yml up --build --wait",
    "stack:down": "docker compose -f docker-compose.e2e.yml down -v",
    "stack:logs": "docker compose -f docker-compose.e2e.yml logs -f",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
